@model List<Doctor_Resrvation_System.Models.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<div class="container-fluid p-0 wow fadeIn" data-wow-delay="0.1s">
    <div class="page-header position-relative" style="height:500px">
        <img class="w-100 h-100" style="object-fit:cover" src="~/images/carousel-1.jpg" alt="Image">
        <div class="page-header-inner py-5 px-3">
            <div class="container">
                <h1 class="display-1 mb-4 text-white animated slideInDown">Find the Right Doctor for You</h1>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="text-center mx-auto mb-5 wow fadeIn" data-wow-delay="0.2s">
            <p class="section-label">Expert Care. Personal Attention.</p>
            <h2 class="display-5 mb-3">Meet Our Specialists</h2>
        </div>
        <div class="row g-4">
            @foreach (var d in Model)
            {
                <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="0.3s">
                    <div class="doctor-item">
                        <div class="overflow-hidden rounded-top">
                            <img class="img-fluid w-100" src="~/images/doctor-@(d.Id).jpg" alt="@d.Name">
                        </div>
                        <div class="doctor-body border border-top-0 rounded-bottom">
                            <p class="small fw-bold text-primary">@d.Specialization</p>
                            <p class="text-muted">@d.SubSpecialization</p>
                            <h5>@d.Name</h5>
                            <p class="mb-4"><i class="fa-solid fa-phone me-2"></i>@d.PhoneNumber</p>
                            <a asp-controller="Appointments" asp-action="Index" asp-route-doctorId="@d.Id"
                               class="btn btn-primary">View Appointments</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>