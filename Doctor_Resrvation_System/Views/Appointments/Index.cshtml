@model Doctor_Resrvation_System.Models.Doctor
@{
    ViewData["Title"] = "Appointments";
}

<div class="container-fluid p-0 wow fadeIn" data-wow-delay="0.1s">
    <div class="page-header position-relative" style="height:350px">
        <img class="w-100 h-100" style="object-fit:cover" src="~/images/carousel-1.jpg" alt="Image">
        <div class="page-header-inner py-5 px-3">
            <div class="container">
                <h1 class="display-1 mb-4 text-white animated slideInDown">Appointments</h1>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center gap-3">
            <img src="~/images/doctor-@(Model.Id).jpg" class="rounded-circle"
                 style="width:90px;height:90px;object-fit:cover" alt="@Model.Name" />
            <div>
                <h4 class="mb-1">@Model.Name</h4>
                <p class="text-primary fw-bold mb-1">@Model.Specialization</p>
                <p class="text-muted">@Model.SubSpecialization</p>
                <p class="mb-0"><i class="fa-solid fa-phone me-2"></i>@Model.PhoneNumber</p>
            </div>
        </div>
    </div>

    <h5 class="mb-3">Available Appointments</h5>

    @if (!Model.Appointments.Any())
    {
        <div class="alert alert-info">No available appointments for this doctor.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var a in Model.Appointments)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <a href="@Url.Action("Book", "Appointments", new { appointmentId = a.Id })"
                       class="btn btn-outline-primary w-100 py-3">
                        <strong>@a.Day</strong><br />@a.Time
                    </a>
                </div>
            }
        </div>
    }

    <a href="@Url.Action("Index", "Home")" class="btn btn-link mt-4">← Back to doctors</a>
</div>